# cp .env.example .env
# Required for M4 (RAGAS eval) and M5 (Enrichment LLM calls).
# Create an API key at https://openrouter.ai/settings/keys
OPENAI_API_KEY=sk-or-v1-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Free model with multilingual and JSON-output support.
# Free endpoints are rate-limited; keep RAGAS max_workers at 1-2.
OPENAI_MODEL=google/gemma-4-31b-it:free
RAGAS_MAX_WORKERS=1
OPENAI_REQUESTS_PER_MINUTE=10
